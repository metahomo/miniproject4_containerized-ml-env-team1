# ==============================================================================
# Docker 빌드 제외 목록 (.dockerignore)
# 보안 비밀값 유출 방지 및 ML/YOLO11 빌드 컨텍스트 최적화 통합본
# ==============================================================================

# 1. 보안 및 비밀값 (최우선 차단 — 이미지 레이어 유출 방지)
**/.env
**/.env.*
!**/.env.example
docker.env
partner/.secrets/
**/.logs/
*.pem
*.key

# 2. 로컬 데이터베이스 (컨테이너 내부 /data 볼륨 격리)
**/*.db
**/*.db-journal
**/*.db-shm
**/*.db-wal

# 3. 로컬 가상환경 및 파이썬/빌드 캐시 (수 GB 전송 낭비 방지)
**/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.ruff_cache/
**/*.egg-info/
**/node_modules/
frontend/dist/
**/*.tsbuildinfo

# 4. 모델 가중치 파일 (호스트 backend/models 볼륨 마운트로 대체)
backend/models/
**/*.pt
**/*.pth
**/*.onnx
**/*.engine

# 5. 대용량 데이터셋 및 추론/학습 결과물
data/
datasets/
runs/
results/

# 6. Git 버전 관리 및 에디터/도구 설정
.git/
.gitignore
.gitattributes
.vscode/
.idea/
.claude/
.specify/
.sad/

# 7. 문서, 압축 파일 및 임시 파일
docs/
*.log
*.tmp
*.bak-*
x_pym/
project2610-full-*.zip