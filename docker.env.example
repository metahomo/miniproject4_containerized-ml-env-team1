# docker.env — 도커로 띄울 때의 백엔드 설정. 복사해서 docker.env 로 쓴다(docker.env 는 커밋하지 않는다).
# 키 순서·설명은 backend/.env.example 과 같다. 여기 값은 도커용으로 채운 것이고, 빈 값은 코드 기본값(backend/cv_api/settings.py)을 쓴다.
# ★ 반드시 직접 채울 것: API_KEYS, ADMIN_KEYS (비우면 백엔드가 시작을 거부한다)

# 저장소: SQLite — 컨테이너의 /data 볼륨에 둔다(컨테이너를 지워도 남는다)
DATABASE_URL=sqlite:////data/cv.db

# 인증 (R6). 형식 caller_id:key — 원문 키는 자기만 보관하고, 여기에는 sha256: 형식으로 넣는다.
# 키 만들기(파이썬이 없어도 된다) — 한 줄에 «원문 키  sha256:<hex>» 가 나온다:
#   docker run --rm python:3.11-slim python -c "import secrets,hashlib;k=secrets.token_urlsafe(24);print(k, 'sha256:'+hashlib.sha256(k.encode()).hexdigest())"
# 예) API_KEYS=web:sha256:<hex>   ADMIN_KEYS=op1:sha256:<hex>   (관리자 키 원문은 최초 로그인에 쓴다)
API_KEYS=
ADMIN_KEYS=

# 요청 규격 (Clarifications 3차 Q5)
IMAGE_MAX_BYTES=
IMAGE_MAX_SIDE=
BATCH_MAX_FRAMES=

# 판독 기준
BLUR_LAPLACIAN_MIN=
LOW_LIGHT_MEAN_MAX=
CONFIDENCE_MIN=
INFER_TIMEOUT_S=

# 검출기: yolov8 엔진 + 머리 검출 가중치. 모델은 이미지에 없다 — 드라이브의 models/ 폴더(.pt 본체 + 같은 이름 .json 모델 카드)를
#   통째로 받아 두면 compose 가 컨테이너의 backend/models/ 에 연결한다. 모델을 바꿀 때는 .pt·.json 을 함께 바꾼다
DETECTOR=yolov8
MODEL_WEIGHTS=models/head_crowdhuman_n1280.pt
MODEL_DEVICE=cpu

# Ollama — DETECTOR=ollama_vl 일 때만. 컨테이너 안의 127.0.0.1 은 컨테이너 자신이라 호스트의 Ollama 는 host.docker.internal
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_VISION_MODEL=

# 인원 세기 기준 (R22) — 머리 모델 0.2 (비우면 0.4 가 쓰여 인원을 적게 센다)
COUNT_CONF_MIN=0.2
FOOTPRINT_M2=

# 외부 연계: fixture(고정 데이터, 키 없이 동작) | bis(대전 BIS 공공 API — BIS_API_KEY 필요)
EXTERNAL_PROVIDER=fixture
BIS_API_KEY=

# 진단 API — 같은 컨테이너 안의 백엔드 자신(9544). 비우면 웹 진단이 503
DIAGNOSIS_API_URL=http://127.0.0.1:9544

# 운영
RETENTION_DAYS=
SERVER_PUBLIC_URL=
