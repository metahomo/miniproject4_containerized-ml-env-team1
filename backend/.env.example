# 이름만 적는다 — 값은 넣지 않는다(비밀값·운영값 모두). 빈 값은 코드 기본값(backend/cv_api/settings.py)을 쓴다 (API 점검 D9)
# backend/.env — 복사해서 .env 로 쓴다. 기본값은 cv_api/settings.py 와 같다. 도커로 띄울 때는 저장소 루트의 docker.env.example

# 저장소: SQLite(개발·시연) / PostgreSQL(운영)
DATABASE_URL=

# 인증 (R6). 형식 caller_id:key (평문 또는 sha256:<hex>). 공개 서버는 반드시 새 값으로, 관리자 키는 sha256: 형식으로 (T095)
#   python -c "import secrets,hashlib;k=secrets.token_urlsafe(24);print(k, 'sha256:'+hashlib.sha256(k.encode()).hexdigest())"
# 비우면 공개된 기본 키(changeme-…)가 쓰이므로 python -m cv_api.serve 가 시작을 거부한다 (BE-1). 로컬 개발에서만 ALLOW_INSECURE_KEYS=1
API_KEYS=
ADMIN_KEYS=
# ALLOW_INSECURE_KEYS=1

# 요청 규격 (Clarifications 3차 Q5)
IMAGE_MAX_BYTES=
IMAGE_MAX_SIDE=
BATCH_MAX_FRAMES=

# 판독 기준
BLUR_LAPLACIAN_MIN=
LOW_LIGHT_MEAN_MAX=
CONFIDENCE_MIN=
INFER_TIMEOUT_S=

# 검출기: yolov8(프로세스 내 적재) | ollama_vl(공유 Ollama 비전 모델) | stub(테스트)
DETECTOR=
# 운영 가중치: 머리 검출 1차 models/head_crowdhuman_n1280.pt (CrowdHuman, 26에폭 mAP50 0.787, T111) + COUNT_CONF_MIN=0.2
#   되돌리기: models/yolov8n.pt + COUNT_CONF_MIN 비움
MODEL_WEIGHTS=
MODEL_DEVICE=
# 검출 대상 auto(가중치에 head 클래스가 있으면 머리, 없으면 person) · YOLO 입력 긴 변 1280(T090) — 기본값 그대로면 두지 않는다
# MODEL_TARGET=auto  MODEL_IMGSZ=1280

# Ollama 공유 서버 (Ollama 유저 가이드 1.1). num_ctx 8192·keep_alive 5m 은 코드에서 고정
OLLAMA_URL=
OLLAMA_VISION_MODEL=

# 인원 세기 기준 기본값 (R22) — 등급 기준 판본에 값이 없을 때. 운영 중 조정은 S3 에서. 머리 모델은 0.2
COUNT_CONF_MIN=
# R20 발자국 면적 — R22 이후 계산에 쓰지 않음 (호환용)
FOOTPRINT_M2=

# 외부 연계: fixture(고정 데이터) | bis(대전 BIS 공공 API — BIS_API_KEY 필요)
EXTERNAL_PROVIDER=
BIS_API_KEY=
# BIS_POS_CACHE_S=60  BIS_STATIC_CACHE_S=21600  BIS_DEFAULT_SPEED_KMH=18

# 진단 API = 지정 모델 게이트웨이 (/v1/web/* 가 부른다, API 점검 A9). 비우면 웹 진단이 503 — 한 프로세스면 http://127.0.0.1:9544
DIAGNOSIS_API_URL=

# 운영
RETENTION_DAYS=
SERVER_PUBLIC_URL=
# python -m cv_api.serve 가 한 프로세스로 여는 포트 (첫 포트가 모델 적재). 같은 앱 — R21-D1
# SERVE_PORTS=[9544,9524]
